# Styvor Environment Variables
PORT=3000
NODE_ENV=development

# Optional Supabase Database Credentials (falls back to built-in in-memory catalog store if omitted)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Razorpay Payment Gateway Credentials (falls back to simulated test checkout if omitted)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Client API endpoint (defaults to /api on same origin)
VITE_API_URL=/api
